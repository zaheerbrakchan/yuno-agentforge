# LLM provider — auto-detected from whichever key is set.
# Set explicitly to force one when both keys exist: openai | anthropic
LLM_PROVIDER=openai

# Option A — OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Option B — Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

TELEGRAM_BOT_TOKEN=...
TELEGRAM_WEBHOOK_URL=https://your-app.onrender.com
DATABASE_URL=sqlite:///./agentforge.db
ENVIRONMENT=development
